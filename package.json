{
  "name": "browser-pattern-recorder",
  "version": "1.0.0",
  "description": "Windows desktop browser with visual pattern recording and matching.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kreatifwira.browserpatternrecorder",
    "productName": "Browser Pattern Recorder",
    "files": ["main.js","preload.js","index.html","style.css","renderer.js"],
    "win": {"target": "nsis"}
  }
}